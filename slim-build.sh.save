#!/bin/bash
# mydraft Electron 精简打包脚本
# 用法: 放到源码根目录（package.json 旁边），bash slim-build.sh
# 不修改源码，不修改 package.json，产物输出到 release-slim/

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
ELECTRON_DIR="$ROOT_DIR/node_modules/electron/dist"

echo "================================="
echo " mydraft 精简打包"
echo "================================="
echo "工作目录: $ROOT_DIR"
echo ""

# ── Step 1: 清理上次产物 ──
echo "[1/5] 清理上次 slim 产物..."
rm -rf "$ROOT_DIR/release-slim"
echo "      完成。"

# ── Step 2: 删除 Electron 不需要的运行时文件 ──
# 这些文件只在 npm install 时存在，删掉后 electron-builder 不会重新打进去
echo "[2/5] 裁剪 Electron 运行时..."

# SwiftShader 软件渲染层 —— UOS/Deepin arm64 有硬件 GL，不需要
SWIFTSHADER_DIR="$ELECTRON_DIR/swiftshader"
if [ -d "$SWIFTSHADER_DIR" ]; then
    rm -rf "$SWIFTSHADER_DIR"
    echo "      ✓ 删除 SwiftShader (软件 Vulkan/GL)"
fi

# Crashpad handler —— 不做崩溃上报就砍掉
CRASHPAD="$ELECTRON_DIR/chrome_crashpad_handler"
if [ -f "$CRASHPAD" ]; then
    rm -f "$CRASHPAD"
    echo "      ✓ 删除 crashpad_handler"
fi

echo "      完成。"

# ── Step 3: 删除多余的 sharp 原生模块 ──
echo "[3/5] 删除多余原生模块..."

# 只保留 sharp-linux-arm64 (glibc)，删除 musl 版本
SHARP_MUSL="$ROOT_DIR/node_modules/@img/sharp-linuxmusl-arm64"
if [ -d "$SHARP_MUSL" ]; then
    rm -rf "$SHARP_MUSL"
    echo "      ✓ 删除 sharp-linuxmusl-arm64 (musl, 不需要)"
fi

# sharp 非 arm64 版本也删掉
for variant in sharp-linux-x64 sharp-linuxmusl-x64 sharp-win32-x64 sharp-darwin-x64 sharp-darwin-arm64; do
    SHARP_DIR="$ROOT_DIR/node_modules/@img/$variant"
    if [ -d "$SHARP_DIR" ]; then
        rm -rf "$SHARP_DIR"
        echo "      ✓ 删除 $variant"
    fi
done

echo "      完成。"

# ── Step 4: 前端构建 ──
echo "[4/5] 前端构建..."
cd "$ROOT_DIR"
ELECTRON=true npm run build
echo "      完成。"

# ── Step 5: electron-builder 打包 (使用精简配置) ──
echo "[5/5] 打包 deb..."
npx electron-builder build --linux --arm64 \
    --config "$ROOT_DIR/electron-builder-optimized.yml" \
    2>&1

echo ""
echo "================================="
echo " 打包完成"
echo " 产物目录: $ROOT_DIR/release-slim/"
echo "================================="

# 显示产物大小
if [ -d "$ROOT_DIR/release-slim" ]; then
    echo ""
    echo "产物:"
    find "$ROOT_DIR/release-slim" -name "*.deb" -exec ls -lh {} 
